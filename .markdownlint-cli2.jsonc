{
  // The package lints itself with the rules it ships. A rule its own
  // documentation cannot satisfy is a rule to reconsider.
  "customRules": ["./src/index.mjs"],
  "config": {
    "default": true,
    "MD013": { "line_length": 100, "code_blocks": false, "tables": false },
    "MD024": { "siblings_only": true }
  },
  "ignores": ["node_modules", "src/fixtures"]
}
