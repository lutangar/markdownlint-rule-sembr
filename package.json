{
  "name": "markdownlint-rule-sembr",
  "version": "0.1.1",
  "description": "markdownlint rules in support of semantic line breaks",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "exports": "./src/index.mjs",
  "bin": {
    "sembr-format": "src/cli.mjs"
  },
  "files": ["src", "!src/**/*.test.ts", "!src/fixtures", "README.md", "LICENSE"],
  "keywords": [
    "markdownlint",
    "markdownlint-rule",
    "sembr",
    "semantic-line-breaks",
    "markdown",
    "lint"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://codeberg.org/lutangar/markdownlint-rule-sembr",
  "bugs": "https://codeberg.org/lutangar/markdownlint-rule-sembr/issues",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/lutangar/markdownlint-rule-sembr.git"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\"",
    "format": "node src/cli.mjs"
  },
  "dependencies": {
    "markdownlint-rule-helpers": "^0.31.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "sentence-splitter": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.22.1",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
